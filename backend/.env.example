# Local Qwen through LM Studio
LOCAL_LLM_BASE_URL=http://127.0.0.1:1234/api/v1
LOCAL_LLM_MODEL=qwen/qwen3.6-27b
LOCAL_LLM_TIMEOUT_SECONDS=300
LOCAL_LLM_CONTEXT_LENGTH=32768
LOCAL_LLM_MAX_OUTPUT_TOKENS=800
LOCAL_LLM_REASONING=off

# PostgreSQL / pgvector
DATABASE_HOST=127.0.0.1
DATABASE_PORT=5432
DATABASE_NAME=document_ai
DATABASE_USER=document_ai
DATABASE_PASSWORD=document_ai_local

# Local development settings
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
EMBEDDING_MODEL=all-MiniLM-L6-v2
CHUNK_SIZE=900
CHUNK_OVERLAP=150
RETRIEVAL_TOP_K=4
MAX_UPLOAD_SIZE_MB=20
